{
  "name": "map-engine",
  "version": "0.0.7",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "dev": "vitest",
    "example": "npm run dev -w example",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:example": "npm run build -w example",
    "typecheck:example": "npm run typecheck -w example",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:bench": "tsc --noEmit -p tsconfig.bench.json",
    "test": "vitest run",
    "bench:registry-alloc": "npm run bench:registry-alloc:1k && npm run bench:registry-alloc:10k",
    "bench:registry-alloc:1k": "NODE_OPTIONS=--expose-gc npx playwright test bench/registry-alloc.spec.ts --config bench/playwright.config.ts --grep @1k",
    "bench:registry-alloc:10k": "NODE_OPTIONS=--expose-gc npx playwright test bench/registry-alloc.spec.ts --config bench/playwright.config.ts --grep @10k",
    "verify:quickstart": "npx playwright test bench/quickstart-verify.spec.ts --config bench/playwright.config.ts",
    "size": "vite build && gzip -c dist/index.js | wc -c"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.183.1",
    "@vitest/browser": "^3.2.4",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "sharp": "^0.33.5",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^3.2.4"
  }
}
