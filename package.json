{
  "name": "map-engine",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "dev": "vitest",
    "example": "npm run dev -w example",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:example": "npm run build -w example",
    "typecheck:example": "npm run typecheck -w example",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "vite build && gzip -c dist/index.js | wc -c",
    "knowledge": "repomix --include 'README.md,CLAUDE.md,docs/**' --stdout"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.183.1",
    "@vitest/browser": "^3.2.4",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "repomix": "^1.13.1",
    "sharp": "^0.33.5",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^3.2.4"
  }
}
